# Rename this file to .env

# Switch target: local | dev | test | perf
ENV=local

# ── Shared (all environments) ────────────────────────────────────────────────
KAFKA_CLIENT_ID=kafka-lag-monitor

POLL_INTERVAL_MS=2000
LOG_PROGRESS_EVERY_MS=10000
SETTLING_PERIOD_MS=30000
EXIT_WHEN_CLEARED=true
TRACK_PERCENTILES=true

CSV_ENABLED=true
HTML_ENABLED=true

PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
DASHBOARD_ENABLED=true

# Optional: suppress KafkaJS connection error logs
# KAFKAJS_LOG_LEVEL=NOTHING

# Optional: override profile selection for a single run
# KAFKA_BROKERS=...
# KAFKA_WATCHES=group:topic

# ══════════════════════════════════════════════════════════════════════════════
# Per-environment Kafka profiles  (prefix = ENV name in uppercase)
# ══════════════════════════════════════════════════════════════════════════════

# ── local ────────────────────────────────────────────────────────────────────
LOCAL_KAFKA_BROKERS=localhost:9092
LOCAL_KAFKA_SSL=false
LOCAL_KAFKA_WATCHES=my-consumer-group:topic-a,topic-b

# Optional SASL per environment (uncomment when needed)
# LOCAL_KAFKA_SASL_MECHANISM=scram-sha-512
# LOCAL_KAFKA_SASL_USERNAME=
# LOCAL_KAFKA_SASL_PASSWORD=
